<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.github.cortavyn</groupId><artifactId>cortavyn-example-mistral</artifactId><version>0.0.1-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
    <artifactId>cortavyn-example-mistral-chat</artifactId>
    <name>Cortavyn Example: Mistral Chat</name>
    <dependencies>
        <dependency><groupId>io.github.cortavyn</groupId><artifactId>cortavyn-provider-mistral</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.github.cortavyn</groupId><artifactId>cortavyn-example-graph-support</artifactId><version>${project.version}</version></dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>run-example</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>run-mistral-chat-example</id>
                                <phase>package</phase>
                                <goals><goal>java</goal></goals>
                                <configuration><mainClass>io.cortavyn.examples.mistral.MistralChatExample</mainClass></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
